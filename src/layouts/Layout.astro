---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";

import Leaf from "@lucide/astro/icons/leaf";
import Instagram from "@lucide/astro/icons/instagram";
import Video from "@lucide/astro/icons/video";
import MessageCircle from "@lucide/astro/icons/message-circle";

const {
  title = "Mamata — Tas Rajut dari Kain Sisa",
  description = "Brand UMKM yang menghadirkan tas rajut dan gantungan kunci dari kain sisa, ramah lingkungan dan penuh cerita.",
} = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/gallery", label: "Gallery" },
];
---
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <ViewTransitions />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen antialiased">
    <header class="relative sticky top-0 z-50 border-b border-mamata-gold-light/20 bg-mamata-navy/90 backdrop-blur-xl">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-mamata-gold-light/10 text-mamata-gold-light shadow-sm"
            aria-hidden="true"
          >
            <Leaf class="h-5 w-5" />
          </span>
          <div class="leading-tight">
            <span class="font-display text-xl font-semibold tracking-wide text-mamata-white">Mamata</span>
            <span class="block text-xs text-mamata-grey">Tas Rajut Upcycle &amp; Aksesoris</span>
          </div>
        </a>

        <div class="hidden items-center gap-6 text-sm font-medium sm:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={["nav-link", pathname === item.href && "nav-link-active"]}
            >
              {item.label}
            </a>
          ))}
        </div>

        <a
          href="https://wa.me/6282218864531"
          class="hidden items-center gap-2 rounded-full bg-mamata-gold-light px-4 py-2 text-xs font-semibold text-mamata-navy shadow-lg shadow-mamata-gold-light/20 transition hover:scale-105 hover:bg-mamata-gold-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mamata-gold-light sm:inline-flex"
          aria-label="Chat WhatsApp Mamata"
        >
          <MessageCircle class="h-4 w-4" />
          <span>Chat WhatsApp</span>
        </a>

        <button
          id="mobile-menu-btn"
          class="inline-flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-full border border-mamata-gold-light/20 bg-navy-800/80 text-mamata-gold-light shadow-sm shadow-black/20 outline-none ring-mamata-gold-light transition hover:bg-navy-800 focus-visible:ring-2 sm:hidden"
          type="button"
          aria-label="Buka Menu"
        >
          <span class="h-0.5 w-4 rounded-full bg-current transition-transform"></span>
          <span class="h-0.5 w-4 rounded-full bg-current transition-transform"></span>
        </button>
      </nav>

      <div
        id="mobile-menu"
        class="absolute left-0 top-full hidden w-full flex-col border-b border-mamata-gold-light/20 bg-navy-950 px-6 py-6 shadow-2xl sm:hidden"
      >
        <div class="flex flex-col gap-6">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "block text-lg font-medium transition-colors",
                pathname === item.href ? "text-mamata-gold-light" : "text-mamata-white hover:text-mamata-gold-light"
              ]}
            >
              {item.label}
            </a>
          ))}
          <div class="mt-2 border-t border-mamata-gold-light/20 pt-6">
            <a
              href="https://wa.me/6282218864531"
              class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-mamata-gold-light px-5 py-3 text-sm font-semibold text-mamata-navy transition hover:bg-mamata-gold-dark"
            >
              <MessageCircle class="h-5 w-5" />
              <span>Konsultasi WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 pb-20 pt-10 sm:px-6">
      <slot />
    </main>

    <footer class="border-t border-mamata-gold-light/20 bg-navy-950/70">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-6 text-sm text-mamata-grey sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <div>
          <p class="font-display text-base font-semibold text-mamata-white">
            Mamata — Tas Rajut dari Kain Sisa
          </p>
          <p class="mt-1 text-xs text-mamata-grey">
            Dibuat dengan tangan, dirajut dari kain sisa yang diberi kehidupan baru.
          </p>
        </div>

        <div class="flex items-center gap-4">
          <a
            href="https://www.instagram.com/mamatacraft/"
            class="inline-flex items-center gap-2 text-mamata-grey transition hover:text-mamata-gold-light"
            target="_blank"
            rel="noreferrer"
          >
            <Instagram class="h-4 w-4" />
            <span class="text-xs font-medium">@mamatacraft</span>
          </a>

          <a
            href="https://www.tiktok.com/@mamatacraft"
            class="inline-flex items-center gap-2 text-mamata-grey transition hover:text-mamata-gold-light"
            target="_blank"
            rel="noreferrer"
          >
            <Video class="h-4 w-4" />
            <span class="text-xs font-medium">@mamatacraft</span>
          </a>
        </div>
      </div>
    </footer>

    <a
      href="https://wa.me/6282218864531"
      class="fixed bottom-5 right-5 z-[60] inline-flex items-center gap-2 rounded-full bg-mamata-gold-light px-4 py-2 text-sm font-semibold text-mamata-navy shadow-xl shadow-mamata-gold-light/20 transition hover:scale-105 hover:bg-mamata-gold-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mamata-gold-light"
      aria-label="Chat WhatsApp Mamata via WhatsApp"
    >
      <MessageCircle class="h-4 w-4" />
      <span>WhatsApp</span>
    </a>

    <script>
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        if (btn && menu) {
          btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
          });
        }
      });
    </script>
  </body>
</html>