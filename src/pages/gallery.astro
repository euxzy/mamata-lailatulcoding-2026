---
import Layout from "../layouts/Layout.astro";
import Sparkles from "@lucide/astro/icons/sparkles";

const items = [
  {
    id: "tas-sage-terracotta",
    title: "Tas Rajut Sage & Terracotta",
    image: "images/CATALOGUE MAMATA CRAFT_page-0002.jpg",
  },
  {
    id: "tas-mini-beige",
    title: "Mini Bucket Bag Beige",
    image: "images/CATALOGUE MAMATA CRAFT_page-0003.jpg",
  },
  {
    id: "gantungan-bunga",
    title: "Gantungan Kunci Bunga Rajut",
    image: "images/CATALOGUE MAMATA CRAFT_page-0004.jpg",
  },
  {
    id: "gantungan-daun",
    title: "Gantungan Kunci Motif Daun",
    image: "images/CATALOGUE MAMATA CRAFT_page-0005.jpg",
  },
  {
    id: "tas-tote-natural",
    title: "Tote Rajut Natural",
    image: "images/CATALOGUE MAMATA CRAFT_page-0006.jpg",
  },
  {
    id: "detail-rajut",
    title: "Detail Tekstur Rajut",
    image: "images/CATALOGUE MAMATA CRAFT_page-0007.jpg",
  },
];
---

<Layout
  title="Gallery Produk — Mamata"
  description="Jelajahi koleksi tas rajut dari kain sisa dan gantungan kunci rajut Mamata. Setiap produk dibuat terbatas dan unik."
>
  <section class="animate-fade-up" style="animation-delay: 0.05s">
    <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-mamata-gold-light">
      <Sparkles class="h-3.5 w-3.5" />
      Gallery produk
    </p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-mamata-white sm:text-4xl">
      Tas rajut &amp; gantungan kunci, <span class="text-gradient-gold">dirajut dari sisa.</span>
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mamata-grey sm:text-base">
      Foto-foto berikut adalah ilustrasi nuansa warna, tekstur rajutan, dan gaya produk Mamata.
      Warna dan motif dapat sedikit berbeda di setiap batch karena mengikuti karakter kain sisa yang
      digunakan.
    </p>
  </section>

  <section class="mt-8 columns-1 gap-5 sm:mt-10 sm:columns-2 lg:columns-3">
    {items.map((item, index) => (
      <div
        class="group relative mb-5 break-inside-avoid w-full overflow-hidden rounded-2xl bg-white p-3 shadow-sm ring-1 ring-mamata-gold-light/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/40 hover:ring-mamata-gold-light/60 animate-fade-up"
        style={`animation-delay: ${0.06 + index * 0.02}s`}
      >
        <img
          src={item.image}
          alt={item.title}
          loading="lazy"
          class="h-auto w-full transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    ))}
  </section>
</Layout>