---
import Layout from "../layouts/Layout.astro";
import Sparkles from "@lucide/astro/icons/sparkles";

// Menggunakan nama produk asli dari katalog Mamata Craft untuk SEO (alt text)
const items = [
  {
    id: "koleksi-amara",
    title: "AMARA - Tas Rajut Eksklusif",
    image: "images/CATALOGUE MAMATA CRAFT_page-0002.jpg",
  },
  {
    id: "koleksi-gamini",
    title: "GAMINI - Tas Rajut Chic",
    image: "images/CATALOGUE MAMATA CRAFT_page-0003.jpg",
  },
  {
    id: "koleksi-sundari",
    title: "SUNDARI - Bucket Bag Mungil",
    image: "images/CATALOGUE MAMATA CRAFT_page-0004.jpg",
  },
  {
    id: "koleksi-lila",
    title: "LILA - Tas Selempang Minimalis",
    image: "images/CATALOGUE MAMATA CRAFT_page-0005.jpg",
  },
  {
    id: "koleksi-garvita",
    title: "GARVITA - Edisi Terbatas",
    image: "images/CATALOGUE MAMATA CRAFT_page-0006.jpg",
  },
  {
    id: "koleksi-yuktika",
    title: "YUKTIKA - Wooden Handle Bag",
    image: "images/CATALOGUE MAMATA CRAFT_page-0007.jpg",
  },
];
---

<Layout
  title="Koleksi Karya — Mamata Craft"
  description="Eksplorasi karya rajut otentik dari Mamata Craft. Setiap produk dibuat secara eksklusif dari limbah tekstil olahan dalam jumlah terbatas."
>
  <section class="animate-fade-up" style="animation-delay: 0.05s">
    <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-mamata-gold-light">
      <Sparkles class="h-3.5 w-3.5" />
      Eksplorasi Karya
    </p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-mamata-white sm:text-4xl lg:text-5xl lg:leading-[1.15]">
      Koleksi otentik, <span class="text-gradient-gold">dirajut dengan kebanggaan.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-mamata-grey sm:text-base">
      Setiap karya Mamata Craft adalah manifestasi dari material tekstil yang diberi napas baru. 
      Dibuat secara manual dan eksklusif dalam jumlah terbatas, menjadikan setiap detail warna dan teksturnya unik—hanya satu untuk Anda.
    </p>
  </section>

  <section class="mt-10 columns-1 gap-5 sm:mt-14 sm:columns-2 lg:columns-3">
    {items.map((item, index) => (
      <div
        class="group relative mb-5 break-inside-avoid w-full overflow-hidden rounded-2xl bg-white p-3 shadow-sm ring-1 ring-mamata-gold-light/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/40 hover:ring-mamata-gold-light/60 animate-fade-up"
        style={`animation-delay: ${0.06 + index * 0.02}s`}
      >
        <img
          src={item.image}
          alt={item.title}
          title={item.title}
          loading="lazy"
          class="h-auto w-full transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    ))}
  </section>
</Layout>