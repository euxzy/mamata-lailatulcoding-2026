---
import Layout from "../layouts/Layout.astro";
import ImageIcon from "@lucide/astro/icons/image";
import Sparkles from "@lucide/astro/icons/sparkles";

const items = [
  {
    id: "tas-sage-terracotta",
    title: "Tas Rajut Sage & Terracotta",
    category: "Tas Rajut dari Kain Sisa",
    image:
      "images/CATALOGUE MAMATA CRAFT_page-0002.jpg",
    description:
      "Tas rajut selempang dengan kombinasi warna sage dan terracotta, cocok untuk dipakai sehari-hari.",
  },
  {
    id: "tas-mini-beige",
    title: "Mini Bucket Bag Beige",
    category: "Tas Rajut dari Kain Sisa",
    image:
      "images/CATALOGUE MAMATA CRAFT_page-0003.jpg",
    description:
      "Tas bucket mini dengan tekstur rajut tebal, pas untuk membawa dompet dan handphone.",
  },
  {
    id: "gantungan-bunga",
    title: "Gantungan Kunci Bunga Rajut",
    category: "Gantungan Kunci Rajut",
    image:
      "images/CATALOGUE MAMATA CRAFT_page-0004.jpg",
    description:
      "Gantungan kunci motif bunga dengan kombinasi benang warna pastel yang lembut.",
  },
  {
    id: "gantungan-daun",
    title: "Gantungan Kunci Motif Daun",
    category: "Gantungan Kunci Rajut",
    image:
      "images/CATALOGUE MAMATA CRAFT_page-0005.jpg",
    description:
      "Detail rajut berbentuk daun yang indah untuk menghias tas atau pouch favoritmu.",
  },
  {
    id: "tas-tote-natural",
    title: "Tote Rajut Natural",
    category: "Tas Rajut dari Kain Sisa",
    image:
      "images/CATALOGUE MAMATA CRAFT_page-0006.jpg",
    description:
      "Tote bag rajut ukuran medium dengan warna natural yang mudah dipadukan dengan berbagai gaya.",
  },
  {
    id: "detail-rajut",
    title: "Detail Tekstur Rajut",
    category: "Detail Rajutan",
    image:
      "images/CATALOGUE MAMATA CRAFT_page-0007.jpg",
    description:
      "Close-up tekstur rajutan yang menunjukkan perpaduan benang dan kain sisa yang rapi.",
  },
];
---

<Layout
  title="Gallery Produk — Mamata"
  description="Jelajahi koleksi tas rajut dari kain sisa dan gantungan kunci rajut Mamata. Setiap produk dibuat terbatas dan unik."
>
  <section class="animate-fade-up" style="animation-delay: 0.05s">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-700">
      Gallery produk
    </p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
      Tas rajut &amp; gantungan kunci, dirajut dari sisa.
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-700 sm:text-base">
      Foto-foto berikut adalah ilustrasi nuansa warna, tekstur rajutan, dan gaya produk Mamata.
      Warna dan motif dapat sedikit berbeda di setiap batch karena mengikuti karakter kain sisa yang
      digunakan.
    </p>
  </section>

  <section class="mt-8 grid gap-5 sm:mt-10 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item, index) => (
      <button
        type="button"
        class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white/80 text-left shadow-sm shadow-sage-200/70 ring-1 ring-sage-100/70 transition hover:-translate-y-1 hover:shadow-md hover:shadow-sage-300/70"
        data-gallery-item
        data-image={item.image}
        data-title={item.title}
        data-description={item.description}
        data-category={item.category}
        style={`animation-delay: ${0.06 + index * 0.02}s`}
      >
        <div class="relative overflow-hidden">
          <img
            src={item.image}
            alt={item.title}
            loading="lazy"
            class="w-full object-scale-down transition-transform duration-500 group-hover:scale-105"
          />

      </button>
    ))}
  </section>

  <dialog
    id="gallery-dialog"
    class="backdrop:bg-black/40 open:animate-fade-up"
    aria-labelledby="gallery-dialog-title"
  >
  </dialog>

  <script>
    const dialog = document.getElementById("gallery-dialog") as HTMLDialogElement | null;
    const dialogImage = document.getElementById(
      "gallery-dialog-image",
    ) as HTMLImageElement | null;
    const dialogTitle = document.getElementById("gallery-dialog-title");
    const dialogDescription = document.getElementById("gallery-dialog-description");
    const dialogCategory = document.getElementById("gallery-dialog-category");

    if (dialog && dialogImage && dialogTitle && dialogDescription && dialogCategory) {
      document.querySelectorAll<HTMLButtonElement>("[data-gallery-item]").forEach((button) => {
        button.addEventListener("click", () => {
          const image = button.dataset.image ?? "";
          const title = button.dataset.title ?? "";
          const description = button.dataset.description ?? "";
          const category = button.dataset.category ?? "";

          dialogImage.src = image;
          dialogImage.alt = title;
          dialogTitle.textContent = title;
          dialogDescription.textContent = description;
          dialogCategory.textContent = category;

          dialog.showModal();
        });
      });
    }
  </script>
</Layout>

