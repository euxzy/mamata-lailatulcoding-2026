---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Mamata — New Blog Post Generator"
  description="Generate Markdown files for Mamata blog posts with correct frontmatter."
>
  <section class="animate-fade-up" style="animation-delay: 0.05s">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-700">
      Admin • Markdown helper
    </p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
      Simple Markdown Generator
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-700 sm:text-base">
      Isi form di samping, lalu salin atau unduh file <code>.md</code> dengan struktur frontmatter
      yang sudah rapi untuk koleksi blog Mamata.
    </p>
  </section>

  <section class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="space-y-4">
      <div class="rounded-2xl bg-white/90 p-5 shadow-sm shadow-sage-200/70 ring-1 ring-sage-100/70">
        <form id="post-form" class="space-y-4">
          <div class="space-y-1">
            <label for="title" class="text-xs font-semibold text-slate-800">
              Judul
            </label>
            <input
              id="title"
              name="title"
              type="text"
              required
              class="w-full rounded-xl border border-sage-100 bg-sage-50/60 px-3 py-2 text-sm text-slate-900 shadow-inner shadow-sage-100/60 outline-none ring-terracotta-400/70 transition focus:border-terracotta-400 focus:bg-white focus:ring-2"
              placeholder="Contoh: Mengapa Tas Rajut Upcycle Itu Spesial?"
            />
          </div>

          <div class="space-y-1">
            <label for="slug" class="text-xs font-semibold text-slate-800">
              Slug
              <span class="font-normal text-slate-500">(otomatis dari judul, bisa diedit)</span>
            </label>
            <input
              id="slug"
              name="slug"
              type="text"
              required
              class="w-full rounded-xl border border-sage-100 bg-sage-50/60 px-3 py-2 text-sm text-slate-900 shadow-inner shadow-sage-100/60 outline-none ring-terracotta-400/70 transition focus:border-terracotta-400 focus:bg-white focus:ring-2"
              placeholder="mengapa-tas-rajut-upcycle-itu-spesial"
            />
          </div>

          <div class="space-y-1">
            <label for="description" class="text-xs font-semibold text-slate-800">
              Deskripsi singkat
            </label>
            <textarea
              id="description"
              name="description"
              rows={3}
              class="w-full resize-none rounded-xl border border-sage-100 bg-sage-50/60 px-3 py-2 text-sm text-slate-900 shadow-inner shadow-sage-100/60 outline-none ring-terracotta-400/70 transition focus:border-terracotta-400 focus:bg-white focus:ring-2"
              placeholder="Ringkasan 1–2 kalimat tentang isi artikel."
            />
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="space-y-1">
              <label for="pubDate" class="text-xs font-semibold text-slate-800">
                Tanggal publikasi
              </label>
              <input
                id="pubDate"
                name="pubDate"
                type="date"
                required
                class="w-full rounded-xl border border-sage-100 bg-sage-50/60 px-3 py-2 text-sm text-slate-900 shadow-inner shadow-sage-100/60 outline-none ring-terracotta-400/70 transition focus:border-terracotta-400 focus:bg-white focus:ring-2"
              />
            </div>

            <div class="space-y-1">
              <label for="tags" class="text-xs font-semibold text-slate-800">
                Tags
                <span class="font-normal text-slate-500">(pisahkan dengan koma)</span>
              </label>
              <input
                id="tags"
                name="tags"
                type="text"
                class="w-full rounded-xl border border-sage-100 bg-sage-50/60 px-3 py-2 text-sm text-slate-900 shadow-inner shadow-sage-100/60 outline-none ring-terracotta-400/70 transition focus:border-terracotta-400 focus:bg-white focus:ring-2"
                placeholder="crochet, upcycle, tutorial"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label for="heroImage" class="text-xs font-semibold text-slate-800">
              Cover image URL
              <span class="font-normal text-slate-500">(heroImage)</span>
            </label>
            <input
              id="heroImage"
              name="heroImage"
              type="url"
              class="w-full rounded-xl border border-sage-100 bg-sage-50/60 px-3 py-2 text-sm text-slate-900 shadow-inner shadow-sage-100/60 outline-none ring-terracotta-400/70 transition focus:border-terracotta-400 focus:bg-white focus:ring-2"
              placeholder="https://images.unsplash.com/..."
            />
          </div>

          <div class="space-y-1">
            <label for="content" class="text-xs font-semibold text-slate-800">
              Konten (Markdown)
            </label>
            <textarea
              id="content"
              name="content"
              rows={10}
              class="w-full rounded-xl border border-sage-100 bg-sage-50/60 px-3 py-2 text-sm text-slate-900 shadow-inner shadow-sage-100/60 outline-none ring-terracotta-400/70 transition focus:border-terracotta-400 focus:bg-white focus:ring-2"
              placeholder="# Judul utama&#10;&#10>Tulis isi artikel di sini dalam format Markdown..."
            />
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <button
              id="download-btn"
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-terracotta-500 px-4 py-2 text-xs font-semibold text-white shadow-md shadow-terracotta-500/40 outline-none ring-terracotta-400/80 transition hover:-translate-y-0.5 hover:bg-terracotta-600 focus-visible:ring-2"
            >
              Generate &amp; Download .md
            </button>

            <button
              id="copy-btn"
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-sage-500/10 px-4 py-2 text-xs font-semibold text-sage-900 shadow-sm shadow-sage-200/70 outline-none ring-terracotta-400/80 transition hover:-translate-y-0.5 hover:bg-sage-500/20 focus-visible:ring-2"
            >
              Copy to clipboard
            </button>
          </div>

          <p id="helper-text" class="text-[11px] text-slate-500">
            File akan diunduh dengan nama <span class="font-semibold">{`{slug}`}</span>.md. Setelah
            itu, pindahkan ke <code>src/content/blog/</code>.
          </p>
        </form>
      </div>
    </div>

    <div class="space-y-3">
      <div
        class="rounded-2xl bg-sage-500/5 p-4 text-xs text-slate-700 shadow-sm shadow-sage-200/70 ring-1 ring-sage-100/70"
      >
        <p class="font-semibold text-slate-900">Preview Markdown</p>
        <p class="mt-1">
          Ini adalah isi lengkap file <code>.md</code> yang akan kamu pakai di koleksi blog Mamata.
        </p>
      </div>

      <div
        class="h-full min-h-[340px] rounded-2xl bg-slate-950/95 text-[11px] text-sage-50 shadow-inner shadow-black/60 ring-1 ring-slate-800"
      >
        <pre
          id="markdown-preview"
          class="h-full max-h-[520px] overflow-auto whitespace-pre-wrap break-words p-4 font-mono text-[11px] leading-relaxed"
        ></pre>
      </div>
    </div>
  </section>

  <script>
    const titleInput = document.getElementById("title");
    const slugInput = document.getElementById("slug");
    const descriptionInput = document.getElementById("description");
    const pubDateInput = document.getElementById("pubDate");
    const tagsInput = document.getElementById("tags");
    const heroImageInput = document.getElementById("heroImage");
    const contentInput = document.getElementById("content");
    const preview = document.getElementById("markdown-preview");
    const downloadBtn = document.getElementById("download-btn");
    const copyBtn = document.getElementById("copy-btn");
    const helperText = document.getElementById("helper-text");

    const today = new Date().toISOString().split("T")[0];
    if (pubDateInput && !pubDateInput.value) {
      pubDateInput.value = today;
    }

    function slugify(value) {
      return value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function escapeQuotes(value) {
      return value.replace(/"/g, '\\"');
    }

    function buildTags(value) {
      if (!value) return "[]";
      const parts = value
        .split(",")
        .map((tag) => tag.trim())
        .filter(Boolean);
      if (!parts.length) return "[]";
      const quoted = parts.map((tag) => `"${escapeQuotes(tag)}"`);
      return `[${quoted.join(", ")}]`;
    }

    function buildMarkdown() {
      const title = titleInput ? titleInput.value.trim() : "";
      const slug = slugInput ? slugInput.value.trim() : "";
      const description = descriptionInput ? descriptionInput.value.trim() : "";
      const pubDate = pubDateInput ? pubDateInput.value || today : today;
      const heroImage = heroImageInput ? heroImageInput.value.trim() : "";
      const tags = tagsInput ? tagsInput.value : "";
      const content = contentInput ? contentInput.value : "";

      const lines = [
        "---",
        `title: "${escapeQuotes(title || "Judul Artikel Mamata")}"`,
        `description: "${escapeQuotes(
          description ||
            "Deskripsi singkat tentang artikel Mamata. Kamu bisa mengedit bagian ini di kemudian hari.",
        )}"`,
        `pubDate: ${pubDate || today}`,
        heroImage ? `heroImage: "${escapeQuotes(heroImage)}"` : undefined,
        `tags: ${buildTags(tags)}`,
        "published: true",
        "---",
        "",
        content || "# Mulai menulis cerita Mamata di sini...",
        "",
      ].filter((line) => typeof line === "string");

      if (helperText) {
        const safeSlug = slug || (title ? slugify(title) : "new-post");
        helperText.innerHTML =
          'File akan diunduh dengan nama <span class="font-semibold">' +
          safeSlug +
          "</span>.md. Setelah itu, pindahkan ke <code>src/content/blog/</code>.";
      }

      return lines.join("\n");
    }

    function updateSlugFromTitle() {
      if (!titleInput || !slugInput) return;
      const generated = slugify(titleInput.value || "");
      if (!slugInput.value || slugify(slugInput.value) === slugify(slugInput.placeholder || "")) {
        slugInput.value = generated;
      }
    }

    function updatePreview() {
      if (!preview) return;
      preview.textContent = buildMarkdown();
    }

    if (titleInput) {
      titleInput.addEventListener("input", () => {
        updateSlugFromTitle();
        updatePreview();
      });
    }

    [slugInput, descriptionInput, pubDateInput, tagsInput, heroImageInput, contentInput].forEach(
      (el) => {
        if (!el) return;
        el.addEventListener("input", updatePreview);
        el.addEventListener("change", updatePreview);
      },
    );

    if (downloadBtn) {
      downloadBtn.addEventListener("click", () => {
        const markdown = buildMarkdown();
        const slug = slugInput && slugInput.value.trim()
          ? slugInput.value.trim()
          : titleInput && titleInput.value.trim()
          ? slugify(titleInput.value.trim())
          : "new-post";

        const blob = new Blob([markdown], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${slug}.md`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const markdown = buildMarkdown();
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(markdown);
          } else {
            const temp = document.createElement("textarea");
            temp.value = markdown;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand("copy");
            temp.remove();
          }
        } catch (error) {
          console.error("Failed to copy markdown:", error);
        }
      });
    }

    updateSlugFromTitle();
    updatePreview();
  </script>
</Layout>

