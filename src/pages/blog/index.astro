---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import CalendarDays from "@lucide/astro/icons/calendar-days";

const posts = (await getCollection("blog", ({ data }) => data.published !== false)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Layout
  title="Artikel &amp; Cerita — Mamata"
  description="Baca cerita di balik produksi tas rajut upcycle, tips merawat produk rajut, dan insight seputar gaya hidup berkelanjutan dari Mamata."
>
  <section class="animate-fade-up" style="animation-delay: 0.05s">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sage-700">
      Artikel &amp; cerita
    </p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
      Belajar pelan-pelan tentang rajut &amp; keberlanjutan.
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-700 sm:text-base">
      Kumpulan tulisan singkat dari studio Mamata — mulai dari perjalanan kain sisa menjadi tas
      rajut, hingga tips merawat koleksimu agar bisa menemani lebih lama.
    </p>
  </section>

  <section class="mt-10 grid gap-6 md:grid-cols-2">
    {posts.map((post, index) => (
      <article
        class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white/80 shadow-sm shadow-sage-200/70 ring-1 ring-sage-100/70 transition hover:-translate-y-1 hover:shadow-md hover:shadow-sage-300/80"
        style={`animation-delay: ${0.08 + index * 0.03}s`}
      >
        {post.data.heroImage && (
          <a href={`/blog/${post.slug}/`} class="relative block overflow-hidden">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              loading="lazy"
              class="h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </a>
        )}

        <div class="flex flex-1 flex-col gap-3 p-5">
          <p class="flex items-center gap-2 text-xs text-slate-500">
            <CalendarDays class="h-4 w-4" />
            <time datetime={post.data.pubDate.toISOString().split("T")[0]}>
              {post.data.pubDate.toLocaleDateString("id-ID", {
                day: "2-digit",
                month: "short",
                year: "numeric",
              })}
            </time>
          </p>

          <h2 class="font-display text-xl font-semibold text-slate-900">
            <a
              href={`/blog/${post.slug}/`}
              class="transition-colors hover:text-terracotta-600"
            >
              {post.data.title}
            </a>
          </h2>

          <p class="text-sm leading-relaxed text-slate-700">{post.data.description}</p>

          <div class="mt-2 flex flex-wrap items-center gap-2">
            {post.data.tags?.map((tag) => (
              <span
                class="rounded-full bg-sage-500/10 px-2.5 py-1 text-[11px] font-medium text-sage-800"
              >
                #{tag}
              </span>
            ))}
          </div>

          <div class="mt-4 flex flex-1 items-end">
            <a
              href={`/blog/${post.slug}/`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-terracotta-600 underline-offset-4 hover:underline"
            >
              Baca selengkapnya
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>
</Layout>

